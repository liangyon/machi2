# Copy to .env and fill in your values

APP_ENV=development
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./arcane_depths.db

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# LLM Provider: groq | gemini | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Session
# Defaults to true (requires HTTPS). Set to false for local dev only.
SESSION_COOKIE_SECURE=false

# Rate limiting
FORGE_RATE_LIMIT=20
